# Hosted platforms may inject PORT automatically; it takes precedence over ORACLE_PORT.
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
WEBAUTHN_RP_ID=localhost

RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=11155111
PROXY_ADDRESS=0xYourProxyAddress

ORACLE_PRIVATE_KEY=your_oracle_private_key

MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/legacy-vault
